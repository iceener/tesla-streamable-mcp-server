{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tesla-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "MCP_TITLE": "Tesla",
    "MCP_VERSION": "1.0.0",
    "MCP_PUBLIC_URL": "http://localhost:8787/mcp",
    "MCP_ALLOWED_HOSTS": "localhost,127.0.0.1,[::1]",
    "MCP_ALLOWED_ORIGIN_HOSTNAMES": "localhost,127.0.0.1,[::1]",
    "MCP_LEGACY_MODE": "stateless",
    "MCP_MAX_REQUEST_BYTES": "1048576",
    "AUTH_ENABLED": "true",
    "AUTH_STRATEGY": "bearer",
    "NODE_ENV": "development",
    "LOG_LEVEL": "info"
  },
  "kv_namespaces": [{ "binding": "TOKENS", "id": "d640ddfc2b4b4d6997c8bb6d2c16ffcf" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
