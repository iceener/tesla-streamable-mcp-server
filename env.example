# Bun server
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MCP identity and fetch-native endpoint
MCP_NAME="Tesla"
MCP_TITLE="Tesla"
MCP_VERSION=1.0.0
MCP_INSTRUCTIONS="Use these tools to control your Tesla vehicle. Be careful with commands that affect vehicle state."
MCP_PUBLIC_URL=http://localhost:3000/mcp
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGIN_HOSTNAMES=localhost,127.0.0.1,[::1]
MCP_LEGACY_MODE=stateless
MCP_MAX_REQUEST_BYTES=1048576
MCP_ACCEPT_HEADERS=

# Static MCP caller authentication
AUTH_ENABLED=true
AUTH_STRATEGY=bearer
BEARER_TOKEN=your-random-mcp-access-token

# Server-side Tessie provider credentials; never derived from BEARER_TOKEN
TESSIE_ACCESS_TOKEN=your-tessie-access-token
TESSIE_VIN=your-vehicle-vin

# Existing operational settings retained by the migration
RPS_LIMIT=10
CONCURRENCY_LIMIT=5
RS_TOKENS_FILE=
RS_TOKENS_ENC_KEY=
